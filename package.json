{
  "name": "muse-encore-vue",
  "version": "1.2.1",
  "description": "TypeScript port of the MuseScore Studio (v4.7.5) engraving engine with Vue 3 & Nuxt UI v3 editor",
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fonts/*": "./fonts/*"
  },
  "files": [
    "dist",
    "fonts",
    "LICENSE"
  ],
  "scripts": {
    "migrate:vue": "node tools/migrate-to-vue.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run --dir test",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "dev": "vite viewer",
    "dev:viewer": "vite viewer",
    "example:viewer": "npm run build:viewer-package && npx http-server packages/viewer",
    "build:viewer": "vite build viewer",
    "build:viewer-package": "tsx tools/build-viewer-package.ts",
    "dev:editor": "vite editor",
    "build:editor": "vite build editor",
    "render": "tsx tools/render.ts",
    "compare": "tsx tools/compare.ts",
    "compare:all": "tsx tools/compare-all.ts",
    "compare:mscx": "tsx tools/compare-mscx.ts",
    "compare:musicxml": "tsx tools/compare-musicxml.ts",
    "roundtrip": "tsx tools/roundtrip.ts",
    "bump-version": "tsx tools/bump-version.ts"
  },
  "dependencies": {
    "@nuxt/ui": "^3.0.2",
    "@tensorflow/tfjs": "^4.22.0",
    "@vueuse/core": "^12.5.0",
    "fflate": "^0.8.3",
    "opentype.js": "^2.0.0",
    "spessasynth_lib": "^4.3.14",
    "tailwindcss": "^4.0.0",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.26",
    "@napi-rs/canvas": "^1.0.11",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "dexie": "^4.4.6",
    "pixelmatch": "^8.0.0",
    "playwright-core": "1.56.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^2.2.4"
  },
  "overrides": {
    "typescript": "5.9.3"
  }
}
